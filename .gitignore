docker-compose.override.yml
# Cho phép push Dockerfile và docker-compose chính
# *.dockerfile  # bỏ comment nếu muốn ignore file dockerfile
# docker-compose*.yaml  # bỏ comment nếu muốn ignore các file compose khác, giữ file chính
# Nếu bạn có docker-compose.dev.yml mà muốn push, bỏ comment như dưới:
# docker-compose.dev.override.yml

